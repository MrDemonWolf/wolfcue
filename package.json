{
	"name": "wolfcue",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"typescript": "^7.0.2",
			"@types/node": "^26.6.6"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "PORT=${PORT:-${WEB_PORT:-3001}} WEB_PORT=${PORT:-${WEB_PORT:-3001}} turbo run dev",
		"dev:web": "turbo run dev -F web",
		"dev:docs": "turbo run dev -F docs",
		"build": "turbo run build && bun run scripts/merge-docs.ts",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check:ci": "biome ci .",
		"check-types": "turbo run check-types && tsc --noEmit",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:e2e": "playwright test",
		"test:shots": "playwright test screenshots.e2e.ts",
		"serve": "bun scripts/serve-site.ts",
		"ci": "bun run check:ci && bun run check-types && bun scripts/check-config.ts && bun test && bun run build && bun run test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "^2.6.2",
		"@playwright/test": "1.64.1",
		"@types/bun": "^1.3.11",
		"@types/node": "catalog:",
		"@wolfcue/config": "workspace:*",
		"turbo": "^2.11.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.4.4"
}
