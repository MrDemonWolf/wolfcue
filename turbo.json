{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "out/**"],
			"env": ["BASE_PATH", "SITE_ORIGIN", "COMMIT_SHA"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"env": ["BASE_PATH", "SITE_ORIGIN"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"env": ["PORT", "WEB_PORT", "DOCS_PORT", "BASE_PATH"]
		}
	},
	"globalPassThroughEnv": ["CI", "TEST_BASE_URL", "SITE_DIR"]
}
